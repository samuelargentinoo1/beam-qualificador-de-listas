# Copie este arquivo para ".env" e preencha com os dados do SEU projeto Supabase

# QUEM PODE ENTRAR NO PAINEL (login individual de cada SDR).
# Formato:  login:senha:Nome Exibido:idNoMoskit   — vários separados por vírgula.
# O id do Moskit é o que define de quem são os leads da lista (node scripts/moskit-usuarios.js).
# A senha não pode ter ":" nem ",". Se a tabela `usuarios` existir no Supabase, ELA manda.
PAINEL_USUARIOS=julia:troque-a-senha:Julia:155073

# (Supabase → Settings → API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-service_role
# Integração Moskit CRM (upload automático de toda lista gerada)
MOSKIT_API_KEY=cole-aqui-a-api-key-do-moskit
MOSKIT_STAGE_ID=510043
# Responsável PADRÃO dos leads no Moskit. No painel, o responsável é QUEM PEDIU a
# lista (login individual — tabela `usuarios` no Supabase); este id só é usado
# quando o pedido não tem usuário (geração local sem login) ou quando o
# moskit_user_id do usuário não existe/está inativo na conta.
# Pra ver os ids:  node scripts/moskit-usuarios.js
MOSKIT_RESPONSIBLE_ID=155074
